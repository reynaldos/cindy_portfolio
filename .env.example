# Copy to .env and fill in. Only the keys the current phase needs are listed; later phases add theirs.
# The names match what the Vercel Neon integration sets, so Vercel needs no extra keys for these.

# Phase 1 — Neon Postgres (pooled URL for the app, direct URL for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Phase 3 — Cloudflare Stream (video) and R2 (images, files)
CF_ACCOUNT_ID="your-cloudflare-account-id"
CF_STREAM_TOKEN="api-token-with-Stream-Edit"
CF_STREAM_WEBHOOK_SECRET="secret-returned-when-you-register-the-webhook"
NEXT_PUBLIC_STREAM_CUSTOMER_CODE="customer-code-from-the-Stream-dashboard"
NEXT_PUBLIC_MEDIA_URL="https://media.example.com"
