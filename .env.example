# Copy to .env and fill in. Only the keys the current phase needs are listed; later phases add theirs.
# The names match what the Vercel Neon integration sets, so Vercel needs no extra keys for these.

# Phase 1 — Neon Postgres (pooled URL for the app, direct URL for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Phase 3 — Cloudflare Stream (video) and R2 (images, files)
CF_ACCOUNT_ID="your-cloudflare-account-id"
CF_STREAM_TOKEN="api-token-with-Stream-Edit"
CF_STREAM_WEBHOOK_SECRET="secret-returned-when-you-register-the-webhook"
NEXT_PUBLIC_STREAM_CUSTOMER_CODE="customer-code-from-the-Stream-dashboard"
NEXT_PUBLIC_MEDIA_URL="https://media.example.com"

# Phase 5 — EmailJS (contact form; turn on "non-browser API requests" in EmailJS Account → Security)
EMAILJS_SERVICE_ID="service_xxx"
EMAILJS_TEMPLATE_ID="template_xxx"
EMAILJS_PUBLIC_KEY="public-key"
EMAILJS_PRIVATE_KEY="private-key"

# Optional — Cloudflare Turnstile (free; Cloudflare dashboard → Turnstile → Add widget). Leave empty to skip the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Phase 6 — admin login. Make the hash with: pnpm exec tsx scripts/hash-password.ts "your password"
ADMIN_PASSWORD_HASH="scrypt:<salt>:<hash>"
# 32+ random bytes, e.g. `openssl rand -hex 32`. Change it to log every session out.
SESSION_SECRET="change-me"

# Phase 6 — R2 uploads from the admin (R2 → Manage API tokens → Object Read & Write on this bucket). Set the bucket CORS policy too (see README).
R2_BUCKET="cuts-by-cindy-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
